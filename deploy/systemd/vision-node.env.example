# /data/hoodseek/vision-node.env — 기기별 값. 실제 IP는 저장소에 넣지 않는다 (설계서 §8.3).
# SafetyCore(Pi 4) 주소. 10/19 사무실 확정 전 값은 docs/ 또는 Slack 기준으로 채운다.
CORE=192.168.x.A:7420
# 카메라 거치 방향. vision_node/tools/measure.sh 회전 확인 결과(0 또는 180)
ROTATE=0
# vision_node/tools/roi_click.py로 만든 파일. 해상도·회전이 다르면 노드가 시작을 거부한다.
ROI=/data/hoodseek/config/roi.json
# ECO.AI CPU 스레드. 2 = voice-node·Flutter와 Pi 5를 나눠 쓰는 기본값 (4스레드 p95 311 ms vs 2스레드 422 ms [실측 10/19])
THREADS=2
# 카메라 카드 영상(UI 설계 v1 §3.2). 127.0.0.1에서만 열린다. 비우면 영상 꺼짐, 판정은 그대로.
# 이 줄은 --preview-port를 아는 바이너리와 $PREVIEW_ARGS가 있는 유닛으로 바꾼 뒤에 넣고, 되돌릴 때는 이 줄을 먼저 지운다
# (옛 바이너리는 모르는 옵션이라 시작을 거부한다). 순서: deploy/README.md 「vision-node 카메라 카드 영상 켜기」
PREVIEW_ARGS=--preview-port 7431
