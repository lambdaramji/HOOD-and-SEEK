# /data/hoodseek/voice-node.env — 실제 값은 기기에서 채우고 Git에 넣지 않는다.
# 기존 SenseVoiceSmall INT8·Silero 모델과 sherpa CPU 런타임을 재사용한다.
# 아래는 배포 예시 경로이며 자동 다운로드하지 않는다. 셸 변수 확장 없이 실제 경로를 쓴다.
SENSEVOICE_MODEL_DIR=/data/hoodseek/models/sensevoice
LD_LIBRARY_PATH=/data/hoodseek/runtime/lib
MIC=alsa_input.usb-Seeed_Studio_ReSpeaker_Lite_0000000001-00.analog-stereo
# 192.0.2.1은 문서용 주소다. 현재 SafetyCore(Pi4)의 숫자 IPv4로 반드시 바꾼다.
CORE_HOST=192.0.2.1
CORE_PORT=7420
# Silero 스트림 VAD. 기존 모델을 기기에 별도 배치한다.
VAD_MODEL=/data/hoodseek/models/ggml-silero-v6.2.0.bin
# SenseVoice는 ASR conf 미제공이며 wire conf=0을 사용한다. Whisper 점수 문턱을 넣지 않는다.
# 빈 값: hello/state 연결과 관측만 수행, voice 미전송.
# 수신 대상/정책 확인 후 실제 발행 시험할 때만 --publish로 바꾸고 수동 restart한다.
VOICE_PUBLISH_ARGS=
